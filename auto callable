"""
MU Single-Stock Autocallable (Swap-Funded) — CCR PFE Model
============================================================
Barclays is the SELLER of the autocallable structure:
  - Barclays PAYS the equity leg  (coupon / KO redemption / KI-adjusted redemption)
  - Barclays RECEIVES the funding leg (SOFR-compound-linked interest on notional)

Term sheet summary:
  KO barrier      : 100% of Strike, observed once on 2027-02-10
  Coupon barrier  : 50% of Strike, observed on 2027-02-10 and 2027-08-11
  KI barrier      : 50% of Strike, European (observed only at maturity, 2027-08-11)
  Memory          : False (missed coupons are not made up later)
  Notional        : 384,000 shares (converted to USD notional using S0)

Methodology:
  1. Calibrate a GARCH(1,1) to MU log-returns; bootstrap standardized residuals
     to simulate 1,000 risk-neutral price paths from pricing date to the final
     observation date (2027-08-11).
  2. For each path, compute the REALIZED net cash flows (Barclays' perspective)
     under the KO / Coupon / KI decision tree -> this is the "ground truth"
     used as the regression target (Y) at every future valuation date.
  3. At each valuation date t, run a cross-sectional regression of discounted
     realized value (from step 2) on the path's price at t (moneyness basis
     functions) to obtain an unbiased estimate of the CONDITIONAL EXPECTED
     value V_hat(t) -- this avoids look-ahead bias (Longstaff-Schwartz style).
  4. Base PFE(t)      = 99th percentile of max(V_hat(t), 0)
     PFE with 10-day MPOR(t) = 99th percentile of
         max( max(V_hat(t),0) - max(V_hat(t-10bd),0), 0 )
     (NOT a raw difference of V -- see write-up: differencing raw V lets
      deeply-negative excursions register as fake positive exposure.)
"""

import pandas as pd
import numpy as np
from scipy.optimize import minimize
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

#%% ---------------------------------------------------------------------
# 0. Term sheet parameters
# -------------------------------------------------------------------------

start_date = pd.Timestamp("2026-08-13")     # Pricing / Strike date
end_date   = pd.Timestamp("2027-08-11")     # Final observation date (NOT the 08-16 payment date)

shares       = 384000                        # term sheet "Size" is share count, not USD notional
coupon_rate  = 0.12790500                    # same rate assumed for both coupon periods (confirmed with desk)

KO_obs_date    = pd.Timestamp("2027-02-10")
KO_pay_date    = pd.Timestamp("2027-02-16")
Final_obs_date = pd.Timestamp("2027-08-11")
Final_pay_date = pd.Timestamp("2027-08-16")

fund1_start, fund1_end = pd.Timestamp("2026-08-17"), pd.Timestamp("2027-02-16")
fund2_start, fund2_end = pd.Timestamp("2027-02-16"), pd.Timestamp("2027-08-16")
tau1 = (fund1_end - fund1_start).days / 360   # ACT/360 for funding leg accrual
tau2 = (fund2_end - fund2_start).days / 360

r_rate         = 0.0362                       # risk-neutral drift AND discount rate (kept consistent)
r_rate_funding = 0.0362                       # SOFR-compound proxy (simplification -- see caveats)

N_PATHS   = 1000
MPOR_DAYS = 10
PFE_PCTL  = 99

#%% ---------------------------------------------------------------------
# 1. Load underlying price history
# -------------------------------------------------------------------------

df = pd.read_excel('MU.xlsx', sheet_name='Sheet1')
df = df[~df['Open'].astype(str).str.contains('Dividend', case=False, na=False)]
df.columns = df.columns.str.strip()
df = df[['Date', 'Adj Close']].set_index('Date')

prices  = df.sort_index().iloc[:, 0]
returns = np.log(prices).diff().dropna().values
S0      = prices.iloc[-1]

Notional     = shares * S0                   # USD notional = shares x Strike price
KO_level     = 1.00 * S0
Coupon_level = 0.50 * S0
KI_level     = 0.50 * S0

#%% ---------------------------------------------------------------------
# 2. GARCH(1,1) calibration (Nelder-Mead MLE)
# -------------------------------------------------------------------------

def garch_h_path(params, r):
    omega, alpha, beta = params
    h = np.empty(len(r))
    h[0] = np.var(r)
    for t in range(1, len(r)):
        h[t] = omega + alpha * r[t-1] ** 2 + beta * h[t-1]
    return h

def negloglik(params, r):
    omega, alpha, beta = params
    if omega <= 0 or alpha < 0 or beta < 0 or alpha + beta >= 0.999:
        return 1e10
    h = garch_h_path(params, r)
    return 0.5 * np.sum(np.log(2 * np.pi * h) + r ** 2 / h)

x0  = [1e-6, 0.05, 0.85]
opt = minimize(negloglik, x0, args=(returns,), method="Nelder-Mead",
                options={"xatol": 1e-10, "fatol": 1e-10, "maxiter": 50000})
omega_hat, alpha_hat, beta_hat = opt.x

h = garch_h_path(opt.x, returns)
z = returns / np.sqrt(h)
z -= z.mean()

h_last, r_last = h[-1], returns[-1]

print(f"GARCH(1,1): omega={omega_hat:.3e}  alpha={alpha_hat:.4f}  beta={beta_hat:.4f}  "
      f"(persistence alpha+beta={alpha_hat+beta_hat:.4f})")

#%% ---------------------------------------------------------------------
# 3. Bootstrap Monte Carlo price paths (risk-neutral)
# -------------------------------------------------------------------------

n_future = np.busday_count(start_date.date(), end_date.date())
dt = 1.0 / 252

rng_boot = np.random.default_rng(2026)
z_star   = rng_boot.choice(z, size=(N_PATHS, n_future), replace=True)

h_path, shock_path = np.empty((N_PATHS, n_future)), np.empty((N_PATHS, n_future))
h_prev, shock_prev  = np.full(N_PATHS, h_last), np.full(N_PATHS, r_last)

for t in range(n_future):
    h_t = omega_hat + alpha_hat * shock_prev**2 + beta_hat * h_prev
    shock_t = np.sqrt(h_t) * z_star[:, t]
    h_path[:, t], shock_path[:, t] = h_t, shock_t
    h_prev, shock_prev = h_t, shock_t

adjusted_returns = (r_rate * dt - 0.5 * h_path) + shock_path
logS = np.log(S0) + np.cumsum(adjusted_returns, axis=1)

S = np.empty((N_PATHS, n_future + 1))
S[:, 0], S[:, 1:] = S0, np.exp(logS)

future_dates = pd.bdate_range(start=start_date, end=end_date)[1:]
assert len(future_dates) == n_future
all_dates = pd.DatetimeIndex([start_date]).append(future_dates)

S_df = pd.DataFrame(S, columns=all_dates)
S_df.index.name = "path"
available_dates = S_df.columns

print(f"Simulated {N_PATHS} paths x {n_future} business days.  S0 = {S0:.2f}")

#%% ---------------------------------------------------------------------
# 4. Realized cash flows per path (KO / Coupon / KI decision tree)
# -------------------------------------------------------------------------

S_KO, S_final = S_df[KO_obs_date].values, S_df[Final_obs_date].values
ko_triggered  = S_KO >= KO_level

net1_arr = np.empty(N_PATHS)
net2_arr = np.full(N_PATHS, np.nan)

for i in range(N_PATHS):
    funding1     = Notional * r_rate_funding * tau1
    coupon1_paid = S_KO[i] >= Coupon_level
    coupon1      = Notional * coupon_rate if coupon1_paid else 0.0

    if ko_triggered[i]:
        net1_arr[i] = funding1 - (coupon1 + Notional)     # KO: pay coupon + full redemption, deal ends
        continue

    net1_arr[i] = funding1 - coupon1                       # no KO: pay coupon only (if triggered), keep going

    funding2     = Notional * r_rate_funding * tau2
    ki_triggered = S_final[i] < KI_level
    if ki_triggered:
        coupon2, principal2 = 0.0, Notional * (S_final[i] / S0)
    else:
        coupon2, principal2 = Notional * coupon_rate, Notional
    net2_arr[i] = funding2 - (coupon2 + principal2)

print(f"KO ratio: {ko_triggered.mean():.2%}   "
      f"KI ratio among survivors: {(S_final[~ko_triggered] < KI_level).mean():.2%}")

#%% ---------------------------------------------------------------------
# 5. Cross-sectional regression -> conditional expected value V_hat(t)
#    (Longstaff-Schwartz style: regress realized discounted CF on today's
#     moneyness to get an unbiased conditional expectation, no look-ahead)
# -------------------------------------------------------------------------

def year_frac(d1, d2):
    return (d2 - d1).days / 365.0

def pv_at(amount, valuation_date, payment_date, r=r_rate_funding):
    return amount * np.exp(-r * year_frac(valuation_date, payment_date))

def basis_matrix(Sv):
    # Moneyness-based basis (S/S0) -- keeps regression well-conditioned;
    # hinge terms at KO (m=1) and KI (m=0.5) help capture barrier curvature.
    m = Sv / S0
    return np.column_stack([np.ones_like(m), m, m**2,
                             np.maximum(m - 1.0, 0),
                             np.maximum(0.5 - m, 0)])

def compute_V_hat(t):
    """Barclays-perspective conditional expected value at date t for all paths."""
    S_t = S_df[t].values
    V = np.zeros(N_PATHS)

    if t < KO_obs_date:
        Y = np.empty(N_PATHS)
        for i in range(N_PATHS):
            pv1 = pv_at(net1_arr[i], t, KO_pay_date)
            Y[i] = pv1 if ko_triggered[i] else pv1 + pv_at(net2_arr[i], t, Final_pay_date)
        X = basis_matrix(S_t)
        beta, *_ = np.linalg.lstsq(X, Y, rcond=None)
        V = X @ beta

    elif t < KO_pay_date:
        alive = ~ko_triggered
        V[ko_triggered] = np.array([pv_at(net1_arr[i], t, KO_pay_date) for i in np.where(ko_triggered)[0]])
        Y_alive = np.array([pv_at(net2_arr[i], t, Final_pay_date) for i in np.where(alive)[0]])
        X_alive = basis_matrix(S_t[alive])
        beta, *_ = np.linalg.lstsq(X_alive, Y_alive, rcond=None)
        V[alive] = X_alive @ beta

    elif t < Final_pay_date:
        alive = ~ko_triggered
        Y_alive = np.array([pv_at(net2_arr[i], t, Final_pay_date) for i in np.where(alive)[0]])
        X_alive = basis_matrix(S_t[alive])
        beta, *_ = np.linalg.lstsq(X_alive, Y_alive, rcond=None)
        V[alive] = X_alive @ beta

    # else: t >= Final_pay_date -> everything settled, V stays 0

    return V

#%% ---------------------------------------------------------------------
# 6. Weekly valuation grid (KO / Final observation dates forced in)
# -------------------------------------------------------------------------

def snap_to_available(d):
    if d in available_dates:
        return d
    idx = available_dates.get_indexer([d], method="nearest")[0]
    return available_dates[idx]

weekly_grid = pd.date_range(start=start_date, end=Final_obs_date, freq="7D")
grid_dates  = sorted(set(snap_to_available(d) for d in weekly_grid) | {KO_obs_date, Final_obs_date})

#%% ---------------------------------------------------------------------
# 7. Base PFE profile (point-in-time, no MPOR)
# -------------------------------------------------------------------------

pfe_rows = []
for t in grid_dates:
    E_t = np.maximum(compute_V_hat(t), 0)
    pfe_rows.append({"date": t,
                      f"PFE_{PFE_PCTL}": np.percentile(E_t, PFE_PCTL),
                      "EE": E_t.mean()})
pfe_df = pd.DataFrame(pfe_rows).set_index("date")

#%% ---------------------------------------------------------------------
# 8. PFE with 10-business-day Margin Period of Risk
#    E_mpor(t) = max( E(t) - E(t-10bd), 0 )   -- NOT a raw V(t)-V(t-10bd) diff.
#    Raw-V differencing lets deeply-negative V "recover" toward zero register
#    as a fake positive exposure jump; flooring each side first fixes this.
# -------------------------------------------------------------------------

def shift_business_days(t, ndays):
    idx = available_dates.get_loc(t)
    return available_dates[max(idx - ndays, 0)]

mpor_rows = []
for t in grid_dates:
    t_minus = shift_business_days(t, MPOR_DAYS)
    if t_minus == t:
        continue
    E_t       = np.maximum(compute_V_hat(t), 0)
    E_t_minus = np.maximum(compute_V_hat(t_minus), 0)
    E_mpor    = np.maximum(E_t - E_t_minus, 0)
    mpor_rows.append({"date": t, "t_minus_10bd": t_minus,
                       f"PFE_MPOR_{PFE_PCTL}": np.percentile(E_mpor, PFE_PCTL)})
pfe_mpor_df = pd.DataFrame(mpor_rows).set_index("date")

#%% ---------------------------------------------------------------------
# 9. Output
# -------------------------------------------------------------------------

pfe_df.to_csv("pfe_df.csv")
pfe_mpor_df.to_csv("pfe_mpor_df.csv")

print("\n=== Base PFE (point-in-time) ===")
print(pfe_df)
print("\n=== PFE with 10-business-day MPOR ===")
print(pfe_mpor_df)

fig, ax = plt.subplots(figsize=(12, 6))
ax.plot(pfe_df.index, pfe_df[f"PFE_{PFE_PCTL}"], color="#B22222", linewidth=2,
        label=f"PFE {PFE_PCTL}% (no MPOR, point-in-time)")
ax.plot(pfe_mpor_df.index, pfe_mpor_df[f"PFE_MPOR_{PFE_PCTL}"], color="#1f77b4", linewidth=2,
        label=f"PFE {PFE_PCTL}% (10-business-day MPOR)")
ax.plot(pfe_df.index, pfe_df["EE"], color="gray", linewidth=1.2, linestyle="--", label="EE (Expected Exposure)")
for d, lbl in [(KO_obs_date, "KO obs"), (Final_obs_date, "Final obs")]:
    ax.axvline(d, color="gray", linestyle=":", linewidth=1)
    ax.text(d, ax.get_ylim()[1], f" {lbl} ({d.date()})", rotation=90, va="top", fontsize=8, color="gray")
ax.set_title("MU Autocallable — CCR Exposure Profile (Barclays as Seller)")
ax.set_ylabel("USD")
ax.legend()
ax.grid(alpha=0.3)
ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f"${x/1e6:.1f}M"))
ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y-%m"))
fig.autofmt_xdate()
plt.tight_layout()
plt.savefig("/mnt/user-data/outputs/MU_Autocallable_PFE_chart.png", dpi=150)
print("\nChart saved.")













"""
Parametrized Autocallable (Swap-Funded) CCR PFE Engine
=========================================================
Generalizes the MU single-period model to an arbitrary number of KO /
coupon observation periods, driven entirely by a `trade_spec` dict.
Barclays is assumed to be the SELLER (pays equity leg, receives funding leg)
for every trade, per desk confirmation.

Usage:
    spec = TRADES["MU"]
    pfe_df, pfe_mpor_df = run_trade(spec, price_file="MU.xlsx")
"""

import pandas as pd
import numpy as np
from scipy.optimize import minimize
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import matplotlib.dates as mdates

N_PATHS   = 1000
MPOR_DAYS = 10
PFE_PCTL  = 99
RNG_SEED  = 2026

#%% ---------------------------------------------------------------------
# 0. Trade specifications (parsed from term sheet image)
#    All dates as "DD-Mon-YY". KOBarrier=1.0 for all four (no step-down).
#    CouponBarrier == KIBarrier numerically for all four trades, but kept
#    as separate parameters since they govern different mechanics
#    (coupon eligibility vs. principal redemption at maturity).
# -------------------------------------------------------------------------

def d(date_str):
    return pd.Timestamp(pd.to_datetime(date_str, format="%d-%b-%y"))

def dlist(s):
    return [d(x.strip()) for x in s.split(",")]

TRADES = {

    "MU": dict(
        ticker="MU", price_file="MU.xlsx",
        pricing_date=d("13-Aug-26"), shares=384000,
        KO_barrier=1.00, coupon_barrier=0.50, KI_barrier=0.50,
        coupon_rate=0.12790500,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27"),
        ko_obs_dates=dlist("10-Feb-27"),
        ko_pay_dates=dlist("16-Feb-27"),
        swap_pay_dates=dlist("16-Feb-27, 16-Aug-27"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27"),
    ),

    "NFLX": dict(
        ticker="NFLX", price_file="NFLX.xlsx",
        pricing_date=d("13-Aug-26"), shares=756000,
        KO_barrier=1.00, coupon_barrier=0.6384, KI_barrier=0.6384,
        coupon_rate=0.07436900,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28"),
        ko_obs_dates=dlist("10-Feb-27, 11-Aug-27"),
        ko_pay_dates=dlist("16-Feb-27, 16-Aug-27"),
        swap_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27, 16-Aug-27"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28"),
    ),

    "GOOGL": dict(
        ticker="GOOGL", price_file="GOOGL.xlsx",
        pricing_date=d("13-Aug-26"), shares=756000,
        KO_barrier=1.00, coupon_barrier=0.6614, KI_barrier=0.6614,
        coupon_rate=0.06418900,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28, 09-Aug-28"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
        ko_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28"),
        ko_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28"),
        swap_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27, 16-Aug-27, 14-Feb-28"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
    ),

    "UNH": dict(
        ticker="UNH", price_file="UNH.xlsx",
        pricing_date=d("13-Aug-26"), shares=756000,
        KO_barrier=1.00, coupon_barrier=0.644, KI_barrier=0.644,
        coupon_rate=0.06306500,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28, 09-Aug-28, 14-Feb-29"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28, 20-Feb-29"),
        ko_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28, 09-Aug-28"),
        ko_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
        swap_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28, 20-Feb-29"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28, 20-Feb-29"),
    ),
}

# Common (non-trade-specific) parameters, applied to every trade unless overridden
COMMON = dict(
    r_rate=0.0362,           # risk-neutral drift & discount rate
    r_rate_funding=0.0362,   # SOFR-compound proxy (simplification)
)

#%% ---------------------------------------------------------------------
# 1. GARCH(1,1) calibration + bootstrap MC (generic, per underlying)
# -------------------------------------------------------------------------

def garch_h_path(params, r):
    omega, alpha, beta = params
    h = np.empty(len(r))
    h[0] = np.var(r)
    for t in range(1, len(r)):
        h[t] = omega + alpha * r[t-1] ** 2 + beta * h[t-1]
    return h

def negloglik(params, r):
    omega, alpha, beta = params
    if omega <= 0 or alpha < 0 or beta < 0 or alpha + beta >= 0.999:
        return 1e10
    h = garch_h_path(params, r)
    return 0.5 * np.sum(np.log(2 * np.pi * h) + r ** 2 / h)

def calibrate_garch(returns):
    x0 = [1e-6, 0.05, 0.85]
    opt = minimize(negloglik, x0, args=(returns,), method="Nelder-Mead",
                    options={"xatol": 1e-10, "fatol": 1e-10, "maxiter": 50000})
    omega_hat, alpha_hat, beta_hat = opt.x
    h = garch_h_path(opt.x, returns)
    z = returns / np.sqrt(h)
    z -= z.mean()
    return omega_hat, alpha_hat, beta_hat, h[-1], returns[-1], z

def simulate_paths(S0, start_date, end_date, omega, alpha, beta, h_last, r_last, z,
                    r_rate, n_paths=N_PATHS, seed=RNG_SEED):
    n_future = np.busday_count(start_date.date(), end_date.date())
    dt = 1.0 / 252
    rng = np.random.default_rng(seed)
    z_star = rng.choice(z, size=(n_paths, n_future), replace=True)

    h_path, shock_path = np.empty((n_paths, n_future)), np.empty((n_paths, n_future))
    h_prev, shock_prev = np.full(n_paths, h_last), np.full(n_paths, r_last)
    for t in range(n_future):
        h_t = omega + alpha * shock_prev**2 + beta * h_prev
        shock_t = np.sqrt(h_t) * z_star[:, t]
        h_path[:, t], shock_path[:, t] = h_t, shock_t
        h_prev, shock_prev = h_t, shock_t

    adjusted_returns = (r_rate * dt - 0.5 * h_path) + shock_path
    logS = np.log(S0) + np.cumsum(adjusted_returns, axis=1)
    S = np.empty((n_paths, n_future + 1))
    S[:, 0], S[:, 1:] = S0, np.exp(logS)

    future_dates = pd.bdate_range(start=start_date, end=end_date)[1:]
    assert len(future_dates) == n_future
    all_dates = pd.DatetimeIndex([start_date]).append(future_dates)

    S_df = pd.DataFrame(S, columns=all_dates)
    S_df.index.name = "path"
    return S_df

#%% ---------------------------------------------------------------------
# 2. Realized cash-flow generator (N-period KO/Coupon/KI decision tree)
# -------------------------------------------------------------------------

def realized_cashflows(spec, S_df, S0):
    """
    For each path, walk through ko_obs_dates in order; on trigger, redeem
    (coupon + full notional) and stop. If never triggered, at the final
    coupon obs date (= maturity) apply the European KI test to principal.
    Funding leg accrues per swap period, path-dependent (stops once redeemed).

    Returns: events (list[list[(payment_date, net_amount_to_Barclays)]]),
             ko_period_idx (array, -1 if never KO'd, else period index)
    """
    shares      = spec["shares"]
    Notional    = shares * S0
    coupon_rate = spec["coupon_rate"]
    KO_level    = spec["KO_barrier"] * S0
    Cpn_level   = spec["coupon_barrier"] * S0
    KI_level    = spec["KI_barrier"] * S0

    ko_obs   = spec["ko_obs_dates"]
    ko_pay   = spec["ko_pay_dates"]
    cpn_obs  = spec["coupon_obs_dates"]
    cpn_pay  = spec["coupon_pay_dates"]
    sw_start = spec["swap_obs_start"]
    sw_end   = spec["swap_obs_end"]
    r_fund   = COMMON["r_rate_funding"]

    n_ko_periods = len(ko_obs)      # periods 0..n_ko_periods-1 have a KO test
    n_periods    = len(cpn_obs)     # total periods, last one is maturity (no KO test)
    N = S_df.shape[0]

    tau = [(sw_end[k] - sw_start[k]).days / 360 for k in range(n_periods)]

    events = [[] for _ in range(N)]
    ko_period_idx = np.full(N, -1, dtype=int)

    for i in range(N):
        resolved = False
        for k in range(n_ko_periods):
            S_k = S_df[ko_obs[k]].values[i]
            funding_k = Notional * r_fund * tau[k]
            coupon_k  = Notional * coupon_rate if S_k >= Cpn_level else 0.0

            if S_k >= KO_level:
                events[i].append((ko_pay[k], funding_k - (coupon_k + Notional)))
                ko_period_idx[i] = k
                resolved = True
                break
            else:
                events[i].append((cpn_pay[k], funding_k - coupon_k))

        if not resolved:
            # Final period: KI test (European, only here) + last coupon test
            k = n_periods - 1
            S_final   = S_df[cpn_obs[k]].values[i]
            funding_k = Notional * r_fund * tau[k]
            ki_trig   = S_final < KI_level
            if ki_trig:
                coupon_k, principal_k = 0.0, Notional * (S_final / S0)
            else:
                coupon_k  = Notional * coupon_rate if S_final >= Cpn_level else 0.0
                principal_k = Notional
            events[i].append((cpn_pay[k], funding_k - (coupon_k + principal_k)))

    return events, ko_period_idx, Notional

#%% ---------------------------------------------------------------------
# 3. Regression valuation V_hat(t) -- generalized to N periods
# -------------------------------------------------------------------------

def year_frac(d1, d2):
    return (d2 - d1).days / 365.0

def pv_at(amount, valuation_date, payment_date, r):
    return amount * np.exp(-r * year_frac(valuation_date, payment_date))

def make_basis_matrix(S0, KO_level_frac, KI_level_frac):
    def basis_matrix(Sv):
        m = Sv / S0
        return np.column_stack([np.ones_like(m), m, m**2,
                                 np.maximum(m - KO_level_frac, 0),
                                 np.maximum(KI_level_frac - m, 0)])
    return basis_matrix

def build_V_hat_func(spec, S_df, S0, events, ko_period_idx, r_rate):
    ko_obs  = spec["ko_obs_dates"]
    ko_pay  = spec["ko_pay_dates"]
    cpn_pay = spec["coupon_pay_dates"]
    n_ko_periods = len(ko_obs)
    N = S_df.shape[0]
    basis_matrix = make_basis_matrix(S0, spec["KO_barrier"], spec["KI_barrier"])

    # Pre-flatten: for each path, its own realized (payment_date, amount) list
    # already stored in `events[i]`.

    def value_of_remaining(i, t):
        """Sum of pv_at(amount, t, pay_date) over events with pay_date > t."""
        total = 0.0
        for pay_date, amount in events[i]:
            if pay_date > t:
                total += pv_at(amount, t, pay_date, r_rate)
        return total

    def resolved_before(t):
        """Boolean mask: path's fate is already determined as of t
        (KO triggered at a period whose obs date <= t)."""
        mask = np.zeros(N, dtype=bool)
        for k in range(n_ko_periods):
            trig_and_known = (ko_period_idx == k) & (ko_obs[k] <= t)
            mask |= trig_and_known
        return mask

    def compute_V_hat(t):
        V = np.zeros(N)
        known = resolved_before(t)
        S_t = S_df[t].values

        # Deterministic part: paths whose fate is already known as of t
        for i in np.where(known)[0]:
            V[i] = value_of_remaining(i, t)

        # Unresolved part: regress realized remaining PV on moneyness at t
        unresolved_idx = np.where(~known)[0]
        if len(unresolved_idx) > 0:
            Y = np.array([value_of_remaining(i, t) for i in unresolved_idx])
            X = basis_matrix(S_t[unresolved_idx])
            beta, *_ = np.linalg.lstsq(X, Y, rcond=None)
            V[unresolved_idx] = X @ beta

        return V

    return compute_V_hat

#%% ---------------------------------------------------------------------
# 4. Full pipeline for one trade
# -------------------------------------------------------------------------

def run_trade(spec, out_prefix=None, n_paths=N_PATHS, mpor_days=MPOR_DAYS, pctl=PFE_PCTL):
    ticker = spec["ticker"]
    out_prefix = out_prefix or ticker

    df = pd.read_excel(spec["price_file"], sheet_name="Sheet1")
    df = df[~df["Open"].astype(str).str.contains("Dividend", case=False, na=False)]
    df.columns = df.columns.str.strip()
    df = df[["Date", "Adj Close"]].set_index("Date")
    prices = df.sort_index().iloc[:, 0]
    returns = np.log(prices).diff().dropna().values
    S0 = prices.iloc[-1]

    omega, alpha, beta, h_last, r_last, z = calibrate_garch(returns)
    print(f"[{ticker}] GARCH: omega={omega:.3e} alpha={alpha:.4f} beta={beta:.4f} "
          f"(persistence={alpha+beta:.4f})  S0={S0:.2f}")

    start_date = spec["pricing_date"]
    end_date   = spec["coupon_obs_dates"][-1]     # final observation date = maturity obs

    S_df = simulate_paths(S0, start_date, end_date, omega, alpha, beta, h_last, r_last, z,
                           COMMON["r_rate"], n_paths=n_paths)
    available_dates = S_df.columns

    events, ko_period_idx, Notional = realized_cashflows(spec, S_df, S0)
    ko_ratio = (ko_period_idx >= 0).mean()
    print(f"[{ticker}] KO ratio (any period): {ko_ratio:.2%}   Notional=${Notional:,.0f}")

    compute_V_hat = build_V_hat_func(spec, S_df, S0, events, ko_period_idx, COMMON["r_rate"])

    def snap(dte):
        if dte in available_dates:
            return dte
        idx = available_dates.get_indexer([dte], method="nearest")[0]
        return available_dates[idx]

    weekly_grid = pd.date_range(start=start_date, end=end_date, freq="7D")
    forced = set(spec["ko_obs_dates"]) | {spec["coupon_obs_dates"][-1]}
    grid_dates = sorted(set(snap(dte) for dte in weekly_grid) | forced)

    pfe_rows = []
    for t in grid_dates:
        E_t = np.maximum(compute_V_hat(t), 0)
        pfe_rows.append({"date": t, f"PFE_{pctl}": np.percentile(E_t, pctl), "EE": E_t.mean()})
    pfe_df = pd.DataFrame(pfe_rows).set_index("date")

    def shift_bd(t, n):
        idx = available_dates.get_loc(t)
        return available_dates[max(idx - n, 0)]

    mpor_rows = []
    for t in grid_dates:
        t_minus = shift_bd(t, mpor_days)
        if t_minus == t:
            continue
        E_t = np.maximum(compute_V_hat(t), 0)
        E_tm = np.maximum(compute_V_hat(t_minus), 0)
        E_mpor = np.maximum(E_t - E_tm, 0)
        mpor_rows.append({"date": t, "t_minus": t_minus, f"PFE_MPOR_{pctl}": np.percentile(E_mpor, pctl)})
    pfe_mpor_df = pd.DataFrame(mpor_rows).set_index("date")

    pfe_df.to_csv(f"{out_prefix}_pfe.csv")
    pfe_mpor_df.to_csv(f"{out_prefix}_pfe_mpor.csv")

    fig, ax = plt.subplots(figsize=(12, 6))
    ax.plot(pfe_df.index, pfe_df[f"PFE_{pctl}"], color="#B22222", linewidth=2,
            label=f"PFE {pctl}% (no MPOR)")
    ax.plot(pfe_mpor_df.index, pfe_mpor_df[f"PFE_MPOR_{pctl}"], color="#1f77b4", linewidth=2,
            label=f"PFE {pctl}% ({mpor_days}bd MPOR)")
    ax.plot(pfe_df.index, pfe_df["EE"], color="gray", linewidth=1.2, linestyle="--", label="EE")
    for dte in spec["ko_obs_dates"]:
        ax.axvline(dte, color="gray", linestyle=":", linewidth=0.8)
    ax.axvline(spec["coupon_obs_dates"][-1], color="black", linestyle=":", linewidth=1)
    ax.set_title(f"{ticker} Autocallable — CCR Exposure Profile (Barclays as Seller)")
    ax.set_ylabel("USD")
    ax.legend()
    ax.grid(alpha=0.3)
    ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f"${x/1e6:.1f}M"))
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%Y-%m"))
    fig.autofmt_xdate()
    plt.tight_layout()
    plt.savefig(f"{out_prefix}_pfe_chart.png", dpi=150)
    plt.close(fig)

    return pfe_df, pfe_mpor_df

#%% ---------------------------------------------------------------------
# 5. Run all trades
# -------------------------------------------------------------------------

if __name__ == "__main__":
    for name, spec in TRADES.items():
        try:
            run_trade(spec)
        except FileNotFoundError:
            print(f"[{name}] SKIPPED — price file '{spec['price_file']}' not found.")





"""
GARCH Version — Daily MTM Matrix (1000 paths x every business day)
=======================================================================
Back to the GARCH-simulated paths (not block bootstrap). Simplest possible
way to get MTM(path, day): reuse the already-validated LSM-style regression
(no nested Monte Carlo, no importance sampling) -- just run it on EVERY
business day instead of a weekly grid, producing a full (N_PATHS x n_days)
matrix of Barclays-perspective MTM values.
"""

import pandas as pd
import numpy as np
from scipy.optimize import minimize

#%% ========================================================================
# BLOCK 0 — Trade selection
# ===========================================================================

def d(date_str):
    return pd.Timestamp(pd.to_datetime(date_str, format="%d-%b-%y"))

def dlist(s):
    return [d(x.strip()) for x in s.split(",")]

TRADES = {
    "MU": dict(
        ticker="MU", price_file="MU.xlsx",
        pricing_date=d("13-Aug-26"), shares=384000,
        KO_barrier=1.00, coupon_barrier=0.50, KI_barrier=0.50,
        coupon_rate=0.12790500,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27"),
        ko_obs_dates=dlist("10-Feb-27"),
        ko_pay_dates=dlist("16-Feb-27"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27"),
    ),
    "GOOGL": dict(
        ticker="GOOGL", price_file="GOOGL.xlsx",
        pricing_date=d("13-Aug-26"), shares=756000,
        KO_barrier=1.00, coupon_barrier=0.6614, KI_barrier=0.6614,
        coupon_rate=0.06418900,
        coupon_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28, 09-Aug-28"),
        coupon_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
        ko_obs_dates=dlist("10-Feb-27, 11-Aug-27, 09-Feb-28"),
        ko_pay_dates=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28"),
        swap_obs_start=dlist("17-Aug-26, 16-Feb-27, 16-Aug-27, 14-Feb-28"),
        swap_obs_end=dlist("16-Feb-27, 16-Aug-27, 14-Feb-28, 14-Aug-28"),
    ),
    # NFLX / UNH: same pattern, add when their price files are available
}

TRADE_NAME = "MU"          # <- change and rerun
spec = TRADES[TRADE_NAME]

N_PATHS   = 1000
RNG_SEED  = 2026
r_rate    = 0.0362
r_funding = 0.0362

#%% ========================================================================
# BLOCK 1 — Load prices, calibrate GARCH(1,1)
# ===========================================================================

raw = pd.read_excel(spec["price_file"], sheet_name="Sheet1")
raw = raw[~raw["Open"].astype(str).str.contains("Dividend", case=False, na=False)]
raw.columns = raw.columns.str.strip()
raw = raw[["Date", "Adj Close"]].set_index("Date")
prices = raw.sort_index().iloc[:, 0]
S0 = prices.iloc[-1]

returns = np.log(prices).diff().dropna().values

def garch_h_path(params, r):
    omega, alpha, beta = params
    h = np.empty(len(r))
    h[0] = np.var(r)
    for t in range(1, len(r)):
        h[t] = omega + alpha * r[t-1] ** 2 + beta * h[t-1]
    return h

def negloglik(params, r):
    omega, alpha, beta = params
    if omega <= 0 or alpha < 0 or beta < 0 or alpha + beta >= 0.999:
        return 1e10
    h = garch_h_path(params, r)
    return 0.5 * np.sum(np.log(2 * np.pi * h) + r ** 2 / h)

opt = minimize(negloglik, [1e-6, 0.05, 0.85], args=(returns,), method="Nelder-Mead",
                options={"xatol": 1e-10, "fatol": 1e-10, "maxiter": 50000})
omega_hat, alpha_hat, beta_hat = opt.x
h = garch_h_path(opt.x, returns)
z = returns / np.sqrt(h)
z -= z.mean()
h_last, r_last = h[-1], returns[-1]

print(f"S0={S0:.2f}  GARCH: omega={omega_hat:.3e} alpha={alpha_hat:.4f} beta={beta_hat:.4f} "
      f"(persistence={alpha_hat+beta_hat:.4f})")

#%% ========================================================================
# BLOCK 2 — Bootstrap GARCH paths
# ===========================================================================

start_date = spec["pricing_date"]
end_date   = spec["coupon_obs_dates"][-1]
n_future = np.busday_count(start_date.date(), end_date.date())
dt = 1.0 / 252

rng = np.random.default_rng(RNG_SEED)
z_star = rng.choice(z, size=(N_PATHS, n_future), replace=True)

h_path, shock_path = np.empty((N_PATHS, n_future)), np.empty((N_PATHS, n_future))
h_prev, shock_prev = np.full(N_PATHS, h_last), np.full(N_PATHS, r_last)
for t in range(n_future):
    h_t = omega_hat + alpha_hat * shock_prev**2 + beta_hat * h_prev
    shock_t = np.sqrt(h_t) * z_star[:, t]
    h_path[:, t], shock_path[:, t] = h_t, shock_t
    h_prev, shock_prev = h_t, shock_t

adjusted_returns = (r_rate * dt - 0.5 * h_path) + shock_path
logS = np.log(S0) + np.cumsum(adjusted_returns, axis=1)
S = np.empty((N_PATHS, n_future + 1))
S[:, 0], S[:, 1:] = S0, np.exp(logS)

future_dates = pd.bdate_range(start=start_date, end=end_date)[1:]
assert len(future_dates) == n_future
all_dates = pd.DatetimeIndex([start_date]).append(future_dates)

S_df = pd.DataFrame(S, columns=all_dates)
S_df.index.name = "path"
available_dates = S_df.columns
print(f"Simulated {N_PATHS} paths x {n_future} business days.")

#%% ========================================================================
# BLOCK 3 — Realized cash flows per path (N-period KO/Coupon/KI tree)
# ===========================================================================

shares      = spec["shares"]
Notional    = shares * S0
coupon_rate = spec["coupon_rate"]
KO_level    = spec["KO_barrier"] * S0
Cpn_level   = spec["coupon_barrier"] * S0
KI_level    = spec["KI_barrier"] * S0

ko_obs, ko_pay   = spec["ko_obs_dates"], spec["ko_pay_dates"]
cpn_obs, cpn_pay = spec["coupon_obs_dates"], spec["coupon_pay_dates"]
sw_start, sw_end = spec["swap_obs_start"], spec["swap_obs_end"]

n_ko_periods = len(ko_obs)
n_periods    = len(cpn_obs)
tau = [(sw_end[k] - sw_start[k]).days / 360 for k in range(n_periods)]

events = [[] for _ in range(N_PATHS)]
ko_period_idx = np.full(N_PATHS, -1, dtype=int)

for i in range(N_PATHS):
    resolved = False
    for k in range(n_ko_periods):
        S_k = S_df[ko_obs[k]].values[i]
        funding_k = Notional * r_funding * tau[k]
        coupon_k  = Notional * coupon_rate if S_k >= Cpn_level else 0.0
        if S_k >= KO_level:
            events[i].append((ko_pay[k], funding_k - (coupon_k + Notional)))
            ko_period_idx[i] = k
            resolved = True
            break
        else:
            events[i].append((cpn_pay[k], funding_k - coupon_k))
    if not resolved:
        k = n_periods - 1
        S_final   = S_df[cpn_obs[k]].values[i]
        funding_k = Notional * r_funding * tau[k]
        if S_final < KI_level:
            coupon_k, principal_k = 0.0, Notional * (S_final / S0)
        else:
            coupon_k = Notional * coupon_rate if S_final >= Cpn_level else 0.0
            principal_k = Notional
        events[i].append((cpn_pay[k], funding_k - (coupon_k + principal_k)))

print(f"Notional=${Notional:,.0f}   KO ratio={100*(ko_period_idx>=0).mean():.1f}%")

#%% ========================================================================
# BLOCK 4 — Regression valuation function (simplest unbiased method: LSM)
# ===========================================================================

def year_frac(d1, d2):
    return (d2 - d1).days / 365.0

def pv_at(amount, valuation_date, payment_date, r=r_funding):
    return amount * np.exp(-r * year_frac(valuation_date, payment_date))

def compute_V_hat(t):
    S_t = S_df[t].values
    V = np.zeros(N_PATHS)

    known_t = np.zeros(N_PATHS, dtype=bool)
    for k in range(n_ko_periods):
        known_t |= (ko_period_idx == k) & (ko_obs[k] <= t)

    for i in np.where(known_t)[0]:
        V[i] = sum(pv_at(amt, t, pay) for pay, amt in events[i] if pay > t)

    unresolved = np.where(~known_t)[0]
    if len(unresolved) > 0:
        Y = np.array([sum(pv_at(amt, t, pay) for pay, amt in events[i] if pay > t)
                       for i in unresolved])
        m = S_t[unresolved] / S0
        X = np.column_stack([np.ones_like(m), m, m**2,
                              np.maximum(m - spec["KO_barrier"], 0),
                              np.maximum(spec["KI_barrier"] - m, 0)])
        beta, *_ = np.linalg.lstsq(X, Y, rcond=None)
        V[unresolved] = X @ beta

    return V

#%% ========================================================================
# BLOCK 5 — Daily MTM matrix: 1000 paths x EVERY business day (not weekly)
# ===========================================================================

mtm_matrix = np.empty((N_PATHS, len(available_dates)))
for j, t in enumerate(available_dates):
    mtm_matrix[:, j] = compute_V_hat(t)

mtm_df = pd.DataFrame(mtm_matrix, columns=available_dates)
mtm_df.index.name = "path"

print(f"MTM matrix shape: {mtm_df.shape}  (paths x days)")
